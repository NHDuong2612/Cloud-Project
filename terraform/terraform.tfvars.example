# Copy to terraform.tfvars and set values for the team's AWS account.
aws_region = "ap-southeast-1"
owner      = "nhom-1"

project_name = "cloudhub"
environment  = "dev"

# Keep disabled until the team reviews the plan and cost.
enable_network = false
enable_storage = false

vpc_cidr                = "10.30.0.0/16"
public_subnet_cidrs     = ["10.30.1.0/24", "10.30.2.0/24"]
private_db_subnet_cidrs = ["10.30.11.0/24", "10.30.12.0/24"]
availability_zones      = []

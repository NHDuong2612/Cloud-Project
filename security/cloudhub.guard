let instances = Resources.*[ Type == 'AWS::EC2::Instance' ]
rule ec2_imdsv2_and_encryption when %instances !empty {
    %instances.Properties {
        MetadataOptions.HttpTokens == 'required'
        BlockDeviceMappings[*].Ebs.Encrypted == true
    }
}

let launch_templates = Resources.*[ Type == 'AWS::EC2::LaunchTemplate' ]
rule launch_template_hardening when %launch_templates !empty {
    %launch_templates.Properties.LaunchTemplateData {
        MetadataOptions.HttpTokens == 'required'
        BlockDeviceMappings[*].Ebs.Encrypted == true
    }
}

let roles = Resources.*[ Type == 'AWS::IAM::Role' ]
rule workloads_are_bounded when %roles !empty {
    %roles.Properties.PermissionsBoundary exists
}

let databases = Resources.*[ Type == 'AWS::RDS::DBInstance' ]
rule database_data_is_protected when %databases !empty {
    %databases {
        DeletionPolicy IN ['Retain', 'Snapshot']
        UpdateReplacePolicy == 'Retain'
        Properties.StorageEncrypted == true OR
        Properties.StorageEncrypted.'Fn::If'[2] == true
        Properties.PubliclyAccessible == false
        Properties.ManageMasterUserPassword == true
    }
}

let listeners = Resources.*[ Type == 'AWS::ElasticLoadBalancingV2::Listener' ]
rule load_balancers_require_https when %listeners !empty {
    %listeners.Properties.Protocol == 'HTTPS'
}

let groups = Resources.*[ Type == 'AWS::EC2::SecurityGroup' ]
rule no_worldwide_ingress when %groups !empty {
    %groups.Properties {
        when SecurityGroupIngress exists {
            SecurityGroupIngress[*] {
                when CidrIp exists { CidrIp != '0.0.0.0/0' OR CidrIp.Ref == 'AllowedCidr' }
                when CidrIpv6 exists { CidrIpv6 != '::/0' }
            }
        }
    }
}

let separate_ingress = Resources.*[ Type == 'AWS::EC2::SecurityGroupIngress' ]
rule no_worldwide_separate_ingress when %separate_ingress !empty {
    %separate_ingress.Properties {
        when CidrIp exists { CidrIp != '0.0.0.0/0' OR CidrIp.Ref == 'AllowedCidr' }
        when CidrIpv6 exists { CidrIpv6 != '::/0' }
    }
}

let tasks = Resources.*[ Type == 'AWS::ECS::TaskDefinition' ]
rule containers_have_readonly_roots when %tasks !empty {
    %tasks.Properties.ContainerDefinitions[*].ReadonlyRootFilesystem == true
}

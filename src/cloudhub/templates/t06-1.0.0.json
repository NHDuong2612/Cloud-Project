{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CloudHub T06 ECS Fargate session; approved immutable image, HTTPS entry and registered per-environment S3 data prefix.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    }
  },
  "Parameters": {
    "EnvironmentId": {
      "Type": "String",
      "AllowedPattern": "^[a-f0-9]{32}$"
    },
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "WorkloadBoundaryArn": {
      "Type": "String",
      "AllowedPattern": "^arn:[^:]+:iam::[0-9]{12}:policy/.+$"
    },
    "AllowedCidr": {
      "Type": "String",
      "AllowedPattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/(2[4-9]|3[0-2])$"
    },
    "ContainerImage": {
      "Type": "String",
      "AllowedPattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z0-9._/-]+@sha256:[a-f0-9]{64}$"
    },
    "ContainerRepositoryArn": {
      "Type": "String",
      "AllowedPattern": "^arn:[^:]+:ecr:[a-z0-9-]+:[0-9]{12}:repository/.+$"
    },
    "RecoveryBucketName": {
      "Type": "String",
      "AllowedPattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
    },
    "Cpu": {
      "Type": "Number",
      "Default": 256,
      "AllowedValues": [
        256,
        512
      ]
    },
    "Memory": {
      "Type": "Number",
      "Default": 512,
      "AllowedValues": [
        512,
        1024,
        2048
      ]
    },
    "DesiredTasks": {
      "Type": "Number",
      "Default": 1,
      "MinValue": 1,
      "MaxValue": 2
    },
    "PublicSubnetIds": {
      "Type": "List<AWS::EC2::Subnet::Id>"
    },
    "CertificateArn": {
      "Type": "String",
      "AllowedPattern": "^arn:[^:]+:acm:[a-z0-9-]+:[0-9]{12}:certificate/[a-f0-9-]+$"
    },
    "HostedZoneId": {
      "Type": "AWS::Route53::HostedZone::Id"
    },
    "DomainName": {
      "Type": "String",
      "AllowedPattern": "^[a-f0-9]{32}\\.[a-z0-9.-]+$"
    }
  },
  "Resources": {
    "InstanceSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Outbound TLS for ECR, S3 and CloudWatch; no direct inbound task access.",
          "must": []
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "GroupDescription": "CloudHub task ENIs; ALB ingress only",
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudHub"
          },
          {
            "Key": "CloudHubEnvironmentId",
            "Value": {
              "Ref": "EnvironmentId"
            }
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "LoadBalancerSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Only HTTPS from the approved network; only application traffic to targets.",
          "must": []
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "GroupDescription": "HTTPS entry for approved client network",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": {
              "Ref": "AllowedCidr"
            }
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8080,
            "ToPort": 8080,
            "DestinationSecurityGroupId": {
              "Ref": "InstanceSecurityGroup"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudHub"
          },
          {
            "Key": "CloudHubEnvironmentId",
            "Value": {
              "Ref": "EnvironmentId"
            }
          }
        ]
      }
    },
    "WebIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Targets receive traffic only from their ALB.",
          "must": []
        }
      },
      "Properties": {
        "GroupId": {
          "Ref": "InstanceSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 8080,
        "ToPort": 8080,
        "SourceSecurityGroupId": {
          "Ref": "LoadBalancerSecurityGroup"
        }
      }
    },
    "LoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Two-AZ entry point with a certificate managed outside the session.",
          "must": []
        }
      },
      "Properties": {
        "Type": "application",
        "Scheme": "internet-facing",
        "Subnets": {
          "Ref": "PublicSubnetIds"
        },
        "SecurityGroups": [
          {
            "Ref": "LoadBalancerSecurityGroup"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "routing.http.drop_invalid_header_fields.enabled",
            "Value": "true"
          },
          {
            "Key": "routing.http.desync_mitigation_mode",
            "Value": "strictest"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudHub"
          },
          {
            "Key": "CloudHubEnvironmentId",
            "Value": {
              "Ref": "EnvironmentId"
            }
          }
        ]
      }
    },
    "TargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Application readiness includes the workload's health contract.",
          "must": []
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "Protocol": "HTTP",
        "Port": 8080,
        "TargetType": "ip",
        "HealthCheckPath": "/health",
        "HealthCheckIntervalSeconds": 15,
        "HealthCheckTimeoutSeconds": 5,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 3,
        "Matcher": {
          "HttpCode": "200"
        },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudHub"
          },
          {
            "Key": "CloudHubEnvironmentId",
            "Value": {
              "Ref": "EnvironmentId"
            }
          }
        ]
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "TLS at the entry point; no plaintext public listener.",
          "must": []
        }
      },
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "LoadBalancer"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "CertificateArn"
            }
          }
        ],
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ]
      }
    },
    "DNS": {
      "Type": "AWS::Route53::RecordSet",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "One hostname per session in the platform-owned zone.",
          "must": []
        }
      },
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZoneId"
        },
        "Name": {
          "Ref": "DomainName"
        },
        "Type": "A",
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": [
              "LoadBalancer",
              "DNSName"
            ]
          },
          "HostedZoneId": {
            "Fn::GetAtt": [
              "LoadBalancer",
              "CanonicalHostedZoneID"
            ]
          }
        }
      }
    },
    "LogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Retain operational logs separately from session data.",
          "must": [
            "F08 must report this retained group and retention."
          ]
        }
      },
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/cloudhub/environments/${EnvironmentId}"
        },
        "RetentionInDays": 14,
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudHub"
          },
          {
            "Key": "CloudHubEnvironmentId",
            "Value": {
              "Ref": "EnvironmentId"
            }
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Runtime pulls the approved image and writes logs; these credentials are not the application task role.",
          "must": [
            "Keep the platform boundary and environment-scoped resource policy."
          ]
        }
      },
      "Properties": {
        "RoleName": {
          "Fn::Sub": "${AWS::StackName}-execution"
        },
        "Path": "/cloudhub/workloads/",
        "PermissionsBoundary": {
          "Ref": "WorkloadBoundaryArn"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "environment-runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchCheckLayerAvailability"
                  ],
                  "Resource": {
                    "Ref": "ContainerRepositoryArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "LogGroup",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudHub"
          },
          {
            "Key": "CloudHubEnvironmentId",
            "Value": {
              "Ref": "EnvironmentId"
            }
          }
        ]
      }
    },
    "TaskRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Application can access only its registered persistent data prefix.",
          "must": [
            "Keep the platform boundary and environment-scoped resource policy."
          ]
        }
      },
      "Properties": {
        "RoleName": {
          "Fn::Sub": "${AWS::StackName}-task"
        },
        "Path": "/cloudhub/workloads/",
        "PermissionsBoundary": {
          "Ref": "WorkloadBoundaryArn"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "environment-runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${RecoveryBucketName}/environments/${EnvironmentId}/data/*"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudHub"
          },
          {
            "Key": "CloudHubEnvironmentId",
            "Value": {
              "Ref": "EnvironmentId"
            }
          }
        ]
      }
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "A session-local cluster keeps inventory and service ownership explicit.",
          "must": []
        }
      },
      "Properties": {
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudHub"
          },
          {
            "Key": "CloudHubEnvironmentId",
            "Value": {
              "Ref": "EnvironmentId"
            }
          }
        ]
      }
    },
    "TaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Immutable task revisions use a non-root, read-only runtime; writable layers are not backups.",
          "must": []
        }
      },
      "Properties": {
        "Family": {
          "Fn::Sub": "${AWS::StackName}-app"
        },
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "Cpu": {
          "Ref": "Cpu"
        },
        "Memory": {
          "Ref": "Memory"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudHub"
          },
          {
            "Key": "CloudHubEnvironmentId",
            "Value": {
              "Ref": "EnvironmentId"
            }
          }
        ],
        "ContainerDefinitions": [
          {
            "Name": "app",
            "Image": {
              "Ref": "ContainerImage"
            },
            "Essential": true,
            "User": "10001:10001",
            "ReadonlyRootFilesystem": true,
            "LinuxParameters": {
              "Capabilities": {
                "Drop": [
                  "ALL"
                ]
              }
            },
            "PortMappings": [
              {
                "ContainerPort": 8080,
                "Protocol": "tcp"
              }
            ],
            "Environment": [
              {
                "Name": "DATA_BUCKET",
                "Value": {
                  "Ref": "RecoveryBucketName"
                }
              },
              {
                "Name": "DATA_PREFIX",
                "Value": {
                  "Fn::Sub": "environments/${EnvironmentId}/data/"
                }
              },
              {
                "Name": "AWS_DEFAULT_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "LogGroup"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "app"
              }
            }
          }
        ]
      }
    },
    "Service": {
      "Type": "AWS::ECS::Service",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Fargate tasks use IP targets; the circuit breaker prevents publishing a broken image.",
          "must": [
            "Approved images must listen on 8080 and provide a meaningful /health endpoint."
          ]
        }
      },
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "TaskDefinition": {
          "Ref": "TaskDefinition"
        },
        "LaunchType": "FARGATE",
        "PlatformVersion": "1.4.0",
        "DesiredCount": {
          "Ref": "DesiredTasks"
        },
        "EnableExecuteCommand": false,
        "EnableECSManagedTags": true,
        "PropagateTags": "SERVICE",
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudHub"
          },
          {
            "Key": "CloudHubEnvironmentId",
            "Value": {
              "Ref": "EnvironmentId"
            }
          }
        ],
        "HealthCheckGracePeriodSeconds": 60,
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          },
          "MinimumHealthyPercent": 100,
          "MaximumPercent": 200
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": {
              "Ref": "PublicSubnetIds"
            },
            "SecurityGroups": [
              {
                "Ref": "InstanceSecurityGroup"
              }
            ]
          }
        },
        "LoadBalancers": [
          {
            "ContainerName": "app",
            "ContainerPort": 8080,
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ]
      },
      "DependsOn": [
        "Listener",
        "WebIngress"
      ]
    }
  },
  "Outputs": {
    "EndpointUrl": {
      "Description": "HTTPS application URL",
      "Value": {
        "Fn::Sub": "https://${DomainName}"
      }
    },
    "TargetGroupArn": {
      "Description": "Readiness probe target group",
      "Value": {
        "Ref": "TargetGroup"
      }
    },
    "ClusterName": {
      "Description": "ECS cluster name",
      "Value": {
        "Ref": "Cluster"
      }
    },
    "ServiceArn": {
      "Description": "ECS service inventory",
      "Value": {
        "Ref": "Service"
      }
    },
    "RegisteredDataPrefix": {
      "Description": "Only this prefix belongs to this environment's backup scope",
      "Value": {
        "Fn::Sub": "s3://${RecoveryBucketName}/environments/${EnvironmentId}/data/"
      }
    }
  },
  "Rules": {
    "FargateSizing": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Or": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "Cpu"
                  },
                  "256"
                ]
              },
              {
                "Fn::Not": [
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "Memory"
                      },
                      "512"
                    ]
                  }
                ]
              }
            ]
          },
          "AssertDescription": "512 CPU units require at least 1024 MiB."
        }
      ]
    }
  }
}

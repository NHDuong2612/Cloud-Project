{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CloudHub T04 HTTPS web fleet with bounded Auto Scaling and private RDS; persistent data stays outside the EC2 fleet.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    }
  },
  "Parameters": {
    "EnvironmentId": {
      "Type": "String",
      "AllowedPattern": "^[a-f0-9]{32}$"
    },
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "WorkloadBoundaryArn": {
      "Type": "String",
      "AllowedPattern": "^arn:[^:]+:iam::[0-9]{12}:policy/.+$"
    },
    "AmiParameter": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    },
    "InstanceType": {
      "Type": "String",
      "Default": "t3.micro",
      "AllowedValues": [
        "t3.micro",
        "t3.small"
      ]
    },
    "VolumeSize": {
      "Type": "Number",
      "Default": 16,
      "MinValue": 8,
      "MaxValue": 64
    },
    "AllowedCidr": {
      "Type": "String",
      "AllowedPattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/(2[4-9]|3[0-2])$"
    },
    "CodeBucket": {
      "Type": "String",
      "AllowedPattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
    },
    "AppBundleKey": {
      "Type": "String",
      "AllowedPattern": "^apps/[a-z0-9_-]+/[a-f0-9]{64}\\.zip$"
    },
    "MinInstances": {
      "Type": "Number",
      "Default": 1,
      "MinValue": 1,
      "MaxValue": 2
    },
    "DesiredInstances": {
      "Type": "Number",
      "Default": 1,
      "MinValue": 1,
      "MaxValue": 3
    },
    "MaxInstances": {
      "Type": "Number",
      "Default": 2,
      "MinValue": 2,
      "MaxValue": 3
    },
    "TargetCPU": {
      "Type": "Number",
      "Default": 50,
      "MinValue": 20,
      "MaxValue": 80
    },
    "PrivateSubnetIds": {
      "Type": "List<AWS::EC2::Subnet::Id>"
    },
    "DBInstanceClass": {
      "Type": "String",
      "Default": "db.t3.micro",
      "AllowedValues": [
        "db.t3.micro",
        "db.t4g.micro"
      ]
    },
    "DBStorage": {
      "Type": "Number",
      "Default": 20,
      "MinValue": 20,
      "MaxValue": 100
    },
    "DBSnapshotIdentifier": {
      "Type": "String",
      "Default": "",
      "MaxLength": 256
    },
    "DBEngineVersion": {
      "Type": "String",
      "Default": "16.15",
      "AllowedPattern": "^16\\.[0-9]+$"
    },
    "PublicSubnetIds": {
      "Type": "List<AWS::EC2::Subnet::Id>"
    },
    "CertificateArn": {
      "Type": "String",
      "AllowedPattern": "^arn:[^:]+:acm:[a-z0-9-]+:[0-9]{12}:certificate/[a-f0-9-]+$"
    },
    "HostedZoneId": {
      "Type": "AWS::Route53::HostedZone::Id"
    },
    "DomainName": {
      "Type": "String",
      "AllowedPattern": "^[a-f0-9]{32}\\.[a-z0-9.-]+$"
    }
  },
  "Resources": {
    "InstanceSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Fleet nodes have outbound TLS for bootstrap; inbound is added only from the ALB.",
          "must": []
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "GroupDescription": "CloudHub fleet; ALB ingress only",
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudHub"
          },
          {
            "Key": "CloudHubEnvironmentId",
            "Value": {
              "Ref": "EnvironmentId"
            }
          }
        ]
      }
    },
    "DatabaseSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "DB is reached only by the application's security group.",
          "must": [
            "Never open PostgreSQL to a CIDR."
          ]
        }
      },
      "Properties": {
        "GroupDescription": "Private CloudHub RDS; app group only",
        "VpcId": {
          "Ref": "VpcId"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudHub"
          },
          {
            "Key": "CloudHubEnvironmentId",
            "Value": {
              "Ref": "EnvironmentId"
            }
          }
        ]
      }
    },
    "DatabaseIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Separate ingress avoids a security-group dependency cycle.",
          "must": []
        }
      },
      "Properties": {
        "GroupId": {
          "Ref": "DatabaseSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "SourceSecurityGroupId": {
          "Ref": "InstanceSecurityGroup"
        }
      }
    },
    "AppDatabaseEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Application DB traffic stays inside the VPC.",
          "must": []
        }
      },
      "Properties": {
        "GroupId": {
          "Ref": "InstanceSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "DestinationSecurityGroupId": {
          "Ref": "DatabaseSecurityGroup"
        }
      }
    },
    "DatabaseSubnets": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "RDS uses private subnets; Single-AZ DB still needs a two-AZ subnet group.",
          "must": []
        }
      },
      "Properties": {
        "DBSubnetGroupDescription": "CloudHub private DB subnets across two AZs",
        "SubnetIds": {
          "Ref": "PrivateSubnetIds"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudHub"
          },
          {
            "Key": "CloudHubEnvironmentId",
            "Value": {
              "Ref": "EnvironmentId"
            }
          }
        ]
      }
    },
    "DatabaseParameters": {
      "Type": "AWS::RDS::DBParameterGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "The demo requires verified TLS for DB connections.",
          "must": []
        }
      },
      "Properties": {
        "Description": "Require TLS for CloudHub PostgreSQL",
        "Family": "postgres16",
        "Parameters": {
          "rds.force_ssl": "1"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudHub"
          },
          {
            "Key": "CloudHubEnvironmentId",
            "Value": {
              "Ref": "EnvironmentId"
            }
          }
        ]
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Dedicated per-session database; credentials managed by RDS. Restore inherits source encryption.",
          "must": [
            "F06 may approve only encrypted PostgreSQL 16 snapshots containing the cloudhub schema.",
            "F08 must inventory final snapshots and their ongoing storage charges."
          ]
        }
      },
      "Properties": {
        "DBInstanceIdentifier": {
          "Fn::Sub": "${AWS::StackName}-db"
        },
        "Engine": "postgres",
        "EngineVersion": {
          "Ref": "DBEngineVersion"
        },
        "EngineLifecycleSupport": "open-source-rds-extended-support-disabled",
        "DBInstanceClass": {
          "Ref": "DBInstanceClass"
        },
        "AllocatedStorage": {
          "Ref": "DBStorage"
        },
        "StorageType": "gp3",
        "StorageEncrypted": {
          "Fn::If": [
            "HasDBSnapshot",
            {
              "Ref": "AWS::NoValue"
            },
            true
          ]
        },
        "DBName": {
          "Fn::If": [
            "HasDBSnapshot",
            {
              "Ref": "AWS::NoValue"
            },
            "cloudhub"
          ]
        },
        "MasterUsername": {
          "Fn::If": [
            "HasDBSnapshot",
            {
              "Ref": "AWS::NoValue"
            },
            "cloudhub_admin"
          ]
        },
        "ManageMasterUserPassword": true,
        "DBSnapshotIdentifier": {
          "Fn::If": [
            "HasDBSnapshot",
            {
              "Ref": "DBSnapshotIdentifier"
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "DBSubnetGroupName": {
          "Ref": "DatabaseSubnets"
        },
        "DBParameterGroupName": {
          "Ref": "DatabaseParameters"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DatabaseSecurityGroup"
          }
        ],
        "PubliclyAccessible": false,
        "MultiAZ": false,
        "BackupRetentionPeriod": 1,
        "CopyTagsToSnapshot": true,
        "DeletionProtection": false,
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudHub"
          },
          {
            "Key": "CloudHubEnvironmentId",
            "Value": {
              "Ref": "EnvironmentId"
            }
          }
        ]
      },
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Retain"
    },
    "LoadBalancerSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Only HTTPS from the approved network; only application traffic to targets.",
          "must": []
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "GroupDescription": "HTTPS entry for approved client network",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": {
              "Ref": "AllowedCidr"
            }
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8080,
            "ToPort": 8080,
            "DestinationSecurityGroupId": {
              "Ref": "InstanceSecurityGroup"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudHub"
          },
          {
            "Key": "CloudHubEnvironmentId",
            "Value": {
              "Ref": "EnvironmentId"
            }
          }
        ]
      }
    },
    "WebIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Targets receive traffic only from their ALB.",
          "must": []
        }
      },
      "Properties": {
        "GroupId": {
          "Ref": "InstanceSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 8080,
        "ToPort": 8080,
        "SourceSecurityGroupId": {
          "Ref": "LoadBalancerSecurityGroup"
        }
      }
    },
    "LoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Two-AZ entry point with a certificate managed outside the session.",
          "must": []
        }
      },
      "Properties": {
        "Type": "application",
        "Scheme": "internet-facing",
        "Subnets": {
          "Ref": "PublicSubnetIds"
        },
        "SecurityGroups": [
          {
            "Ref": "LoadBalancerSecurityGroup"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "routing.http.drop_invalid_header_fields.enabled",
            "Value": "true"
          },
          {
            "Key": "routing.http.desync_mitigation_mode",
            "Value": "strictest"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudHub"
          },
          {
            "Key": "CloudHubEnvironmentId",
            "Value": {
              "Ref": "EnvironmentId"
            }
          }
        ]
      }
    },
    "TargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Application readiness includes the workload's health contract.",
          "must": []
        }
      },
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "Protocol": "HTTP",
        "Port": 8080,
        "TargetType": "instance",
        "HealthCheckPath": "/health",
        "HealthCheckIntervalSeconds": 15,
        "HealthCheckTimeoutSeconds": 5,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 3,
        "Matcher": {
          "HttpCode": "200"
        },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudHub"
          },
          {
            "Key": "CloudHubEnvironmentId",
            "Value": {
              "Ref": "EnvironmentId"
            }
          }
        ]
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "TLS at the entry point; no plaintext public listener.",
          "must": []
        }
      },
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "LoadBalancer"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "CertificateArn"
            }
          }
        ],
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ]
      }
    },
    "DNS": {
      "Type": "AWS::Route53::RecordSet",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "One hostname per session in the platform-owned zone.",
          "must": []
        }
      },
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZoneId"
        },
        "Name": {
          "Ref": "DomainName"
        },
        "Type": "A",
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": [
              "LoadBalancer",
              "DNSName"
            ]
          },
          "HostedZoneId": {
            "Fn::GetAtt": [
              "LoadBalancer",
              "CanonicalHostedZoneID"
            ]
          }
        }
      }
    },
    "InstanceRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Dedicated instance identity; SSM avoids inbound SSH.",
          "must": [
            "Keep the platform boundary and environment-specific resource policies."
          ]
        }
      },
      "Properties": {
        "RoleName": {
          "Fn::Sub": "${AWS::StackName}-instance"
        },
        "Path": "/cloudhub/workloads/",
        "PermissionsBoundary": {
          "Ref": "WorkloadBoundaryArn"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "environment-runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:UpdateInstanceInformation",
                    "ssmmessages:CreateControlChannel",
                    "ssmmessages:CreateDataChannel",
                    "ssmmessages:OpenControlChannel",
                    "ssmmessages:OpenDataChannel"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${CodeBucket}/${AppBundleKey}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Database",
                      "MasterUserSecret.SecretArn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "cloudformation:SignalResource",
                  "Resource": {
                    "Ref": "AWS::StackId"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudHub"
          },
          {
            "Key": "CloudHubEnvironmentId",
            "Value": {
              "Ref": "EnvironmentId"
            }
          }
        ]
      }
    },
    "InstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Attach the environment role without static credentials.",
          "must": []
        }
      },
      "Properties": {
        "InstanceProfileName": {
          "Fn::Sub": "${AWS::StackName}-profile"
        },
        "Path": "/cloudhub/workloads/",
        "Roles": [
          {
            "Ref": "InstanceRole"
          }
        ]
      }
    },
    "LaunchTemplate": {
      "Type": "AWS::EC2::LaunchTemplate",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "A versioned launch template permits controlled rolling replacement.",
          "must": []
        }
      },
      "Properties": {
        "LaunchTemplateData": {
          "ImageId": {
            "Ref": "AmiParameter"
          },
          "InstanceType": {
            "Ref": "InstanceType"
          },
          "CreditSpecification": {
            "CpuCredits": "standard"
          },
          "MetadataOptions": {
            "HttpTokens": "required",
            "HttpEndpoint": "enabled",
            "HttpPutResponseHopLimit": 1
          },
          "NetworkInterfaces": [
            {
              "DeviceIndex": "0",
              "AssociatePublicIpAddress": true,
              "Groups": [
                {
                  "Ref": "InstanceSecurityGroup"
                }
              ]
            }
          ],
          "BlockDeviceMappings": [
            {
              "DeviceName": "/dev/xvda",
              "Ebs": {
                "VolumeType": "gp3",
                "VolumeSize": {
                  "Ref": "VolumeSize"
                },
                "Encrypted": true,
                "DeleteOnTermination": true
              }
            }
          ],
          "IamInstanceProfile": {
            "Name": {
              "Ref": "InstanceProfile"
            }
          },
          "UserData": {
            "Fn::Base64": {
              "Fn::Sub": "#!/bin/bash\nset -eu\ndnf install -y aws-cfn-bootstrap\ntrap '/opt/aws/bin/cfn-signal -e $? --stack ${AWS::StackName} --resource AutoScalingGroup --region ${AWS::Region}' EXIT\ndnf install -y python3-pip\nid cloudhub >/dev/null 2>&1 || useradd --system --home-dir /opt/cloudhub --shell /sbin/nologin cloudhub\ninstall -d -m 755 /opt/cloudhub\npython3 -m venv /opt/cloudhub/venv\n/opt/cloudhub/venv/bin/pip install 'boto3>=1.35,<2' 'psycopg[binary]>=3.2,<4'\n/opt/cloudhub/venv/bin/python -c 'import boto3; boto3.client(\"s3\", region_name=\"${AWS::Region}\").download_file(\"${CodeBucket}\", \"${AppBundleKey}\", \"/opt/cloudhub/application.zip\")'\n/opt/cloudhub/venv/bin/python -m zipfile -e /opt/cloudhub/application.zip /opt/cloudhub/application\ncurl --fail --silent --show-error https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem -o /opt/cloudhub/rds-ca.pem\ncat > /opt/cloudhub/environment <<'CONFIG'\nDB_HOST=${Database.Endpoint.Address}\nDB_SECRET_ARN=${Database.MasterUserSecret.SecretArn}\nDB_CA_FILE=/opt/cloudhub/rds-ca.pem\nAWS_DEFAULT_REGION=${AWS::Region}\nPORT=8080\nPYTHONDONTWRITEBYTECODE=1\nCONFIG\nchown root:cloudhub /opt/cloudhub/environment\nchmod 640 /opt/cloudhub/environment\ncat > /etc/systemd/system/cloudhub.service <<'SERVICE'\n[Unit]\nDescription=CloudHub CRUD demo\nAfter=network-online.target\nWants=network-online.target\n[Service]\nUser=cloudhub\nGroup=cloudhub\nEnvironmentFile=/opt/cloudhub/environment\nWorkingDirectory=/opt/cloudhub/application\nExecStart=/opt/cloudhub/venv/bin/python /opt/cloudhub/application/server.py\nRestart=always\nRestartSec=5\nNoNewPrivileges=true\nPrivateTmp=true\nProtectSystem=strict\nProtectHome=true\n[Install]\nWantedBy=multi-user.target\nSERVICE\nsystemctl daemon-reload\nsystemctl enable --now cloudhub\n\nfor attempt in $(seq 1 60); do\n  curl --fail --silent http://127.0.0.1:8080/health && break\n  sleep 5\ndone\ncurl --fail --silent http://127.0.0.1:8080/health\n"
            }
          },
          "TagSpecifications": [
            {
              "ResourceType": "instance",
              "Tags": [
                {
                  "Key": "Project",
                  "Value": "CloudHub"
                },
                {
                  "Key": "CloudHubEnvironmentId",
                  "Value": {
                    "Ref": "EnvironmentId"
                  }
                }
              ]
            },
            {
              "ResourceType": "volume",
              "Tags": [
                {
                  "Key": "Project",
                  "Value": "CloudHub"
                },
                {
                  "Key": "CloudHubEnvironmentId",
                  "Value": {
                    "Ref": "EnvironmentId"
                  }
                }
              ]
            }
          ]
        }
      }
    },
    "AutoScalingGroup": {
      "Type": "AWS::AutoScaling::AutoScalingGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Fleet scales only within server-validated bounds; RDS owns durable data.",
          "must": [
            "Use ELB health checks and signal readiness after the DB write/read probe."
          ]
        }
      },
      "Properties": {
        "VPCZoneIdentifier": {
          "Ref": "PublicSubnetIds"
        },
        "LaunchTemplate": {
          "LaunchTemplateId": {
            "Ref": "LaunchTemplate"
          },
          "Version": {
            "Fn::GetAtt": [
              "LaunchTemplate",
              "LatestVersionNumber"
            ]
          }
        },
        "MinSize": {
          "Ref": "MinInstances"
        },
        "DesiredCapacity": {
          "Ref": "DesiredInstances"
        },
        "MaxSize": {
          "Ref": "MaxInstances"
        },
        "HealthCheckType": "ELB",
        "HealthCheckGracePeriod": 240,
        "TargetGroupARNs": [
          {
            "Ref": "TargetGroup"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "CloudHub",
            "PropagateAtLaunch": true
          },
          {
            "Key": "CloudHubEnvironmentId",
            "Value": {
              "Ref": "EnvironmentId"
            },
            "PropagateAtLaunch": true
          }
        ]
      },
      "DependsOn": [
        "Listener",
        "DatabaseIngress",
        "AppDatabaseEgress",
        "WebIngress"
      ],
      "CreationPolicy": {
        "ResourceSignal": {
          "Count": {
            "Ref": "DesiredInstances"
          },
          "Timeout": "PT15M"
        }
      },
      "UpdatePolicy": {
        "AutoScalingRollingUpdate": {
          "MinInstancesInService": {
            "Ref": "MinInstances"
          },
          "MaxBatchSize": 1,
          "PauseTime": "PT15M",
          "WaitOnResourceSignals": true
        }
      }
    },
    "ScalingPolicy": {
      "Type": "AWS::AutoScaling::ScalingPolicy",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "CPU target tracking operates within the ASG maximum, never unlimited scale-out.",
          "must": []
        }
      },
      "Properties": {
        "AutoScalingGroupName": {
          "Ref": "AutoScalingGroup"
        },
